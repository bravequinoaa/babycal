# Copy this file to .env and fill in real values before running docker-compose.
# Never commit the real .env file.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=babycal.example.com,localhost,127.0.0.1
TIME_ZONE=America/New_York

# --- Database (used by the `web` service; docker-compose injects the host/port) ---
POSTGRES_DB=babycal
POSTGRES_USER=babycal
POSTGRES_PASSWORD=change-me

# --- Nginx / TLS ---
DOMAIN_NAME=babycal.example.com

# --- Login OTP (see SPEC.md section 3) ---
# False (default): no SMS provider configured yet -> login skips verification.
# True: real OTP codes are generated and "sent" via sms/services.py (still a
# stub until Twilio credentials below are wired into that function).
OTP_PROVIDER_ENABLED=False
OTP_CODE_TTL_SECONDS=300

# --- Twilio (stubbed — send_sms() just logs today, see sms/services.py) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (parent claim notifications) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=babycal@example.com
