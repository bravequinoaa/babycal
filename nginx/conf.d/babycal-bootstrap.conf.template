# HTTP-only bootstrap config: use this ONE TIME for the very first run, before
# any Let's Encrypt certificate exists, so certbot's webroot challenge and the
# app itself are reachable over plain HTTP. Swap back to babycal.conf.template
# once the first certificate has been issued (see README.md).
# ${DOMAIN_NAME} is filled in at container start via envsubst.

server {
    listen 80;
    server_name ${DOMAIN_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /static/ {
        alias /app/staticfiles/;
    }

    location /media/ {
        alias /app/media/;
    }

    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }
}
